<Project Sdk="Microsoft.NET.Sdk">

  <!-- 自测宿主：在真实 WPF 环境里构造每个窗口，抓 XAML/资源引用这类只在运行期才炸的问题。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 跟主工程一致，真实 OCR / 视频探针使用精简原生 ABI。 -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlashTrans.SelfTest</AssemblyName>
    <RootNamespace>FlashTrans.SelfTest</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlashTrans\FlashTrans.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让设置写到自己目录，不碰用户的 %AppData%\FlashTrans -->
    <None Include="portable.txt" CopyToOutputDirectory="PreserveNewest" />

    <!-- RapidOCR 模型：自测输出目录也要有一份，only-ocr 参数 才能验本地引擎 -->
    <None Include="..\..\src\FlashTrans\models\v6\*.*"
          Exclude="..\..\src\FlashTrans\models\v6\PP-OCRv6_rec_tiny.onnx;..\..\src\FlashTrans\models\v6\ppocrv6_tiny_dict.txt"
          Link="models\v6\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
