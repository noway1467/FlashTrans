<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows OCR / 语音 / 录制直接使用系统 ABI，不携带完整 Windows SDK 投影。 -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlashTrans</AssemblyName>
    <RootNamespace>FlashTrans</RootNamespace>
    <Version>1.9.10</Version>
    <Product>闪译 FlashTrans</Product>
    <Company>FlashTrans</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 启动速度相关 -->
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 文件翻译与 OCR 不在启动路径；保留 IL，避免冷路径库的 R2R 原生代码膨胀单文件。 -->
    <PublishReadyToRunExclude Include="UglyToad.PdfPig.dll;UglyToad.PdfPig.Core.dll;UglyToad.PdfPig.DocumentLayoutAnalysis.dll;UglyToad.PdfPig.Fonts.dll;UglyToad.PdfPig.Package.dll;UglyToad.PdfPig.Tokenization.dll;UglyToad.PdfPig.Tokens.dll" />
    <PublishReadyToRunExclude Include="PdfSharp-wpf.dll;PdfSharp.WPFonts.dll;PdfSharp.Snippets-wpf.dll;PdfSharp.Charting-wpf.dll;PdfSharp.BarCodes-wpf.dll;PdfSharp.Quality-wpf.dll;PdfSharp.Shared.dll;PdfSharp.Cryptography.dll;PdfSharp.System.dll" />
    <PublishReadyToRunExclude Include="Markdig.dll;Microsoft.ML.OnnxRuntime.dll;Clipper2Lib.dll;System.Numerics.Tensors.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自测要摸几个 internal（裁图、蒙层截图），不为了测试把它们变成 public。 -->
    <InternalsVisibleTo Include="FlashTrans.SelfTest" />
    <!-- 本地 PP-OCRv6 直接推理与检测框扩张，避免图像库带入跨平台原生资产。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <!-- 用语法树定位正文，避免改写 Markdown 代码、链接和元数据。 -->
    <PackageReference Include="Markdig" Version="0.41.3" />
    <!-- PDF 仅在本机解析；输出正文重排版，不上传文件，也不使用商业转换服务。 -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 嵌一份进程序集，XAML 里写 pack URI 时从这儿取。单文件发布下这条路走得通。 -->
    <Resource Include="Assets\app.ico" />

    <!-- 托盘图标要从磁盘读 ico：LoadImage 读不了 exe 里的资源。
         这里用 None 而不是 Content：Content 会额外生成
         AssemblyAssociatedContentFileAttribute("assets/app.ico")，让 pack URI 优先
         去解析「程序集旁边的内容文件」。单文件发布时程序集没有物理路径，
         那条路会在 ContentFilePart.GetStreamCore 里 Path.Combine(null, ...) 抛
         ArgumentNullException，把整个窗口的 XAML 加载带崩。
         None 只管拷文件，不注册内容文件，pack URI 就老实回退到上面的 Resource。 -->
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />

    <!-- 录制动图存 WebP 要用的 img2webp.exe，放到 Assets\tools\ 就会被拷到输出目录，
         没放也不影响编译（通配符匹配不到就是空集）。为什么是外挂一个程序、
         从哪儿拿，见那个目录里的 README.txt 和 Services\AnimEncoder.cs。
         许可证跟着一起拷：BSD-3-Clause 要求二次分发时带上。 -->
    <None Include="Assets\tools\*.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\tools\libwebp-COPYING.txt" CopyToOutputDirectory="PreserveNewest" />

    <!-- tiny 检测 + small 识别支持中英日；旧 tiny 识别资产仅保留作源码对照。
         Apache-2.0，来源与校验见 models\v6\README.txt。 -->
    <None Include="models\v6\*.onnx" Exclude="models\v6\PP-OCRv6_rec_tiny.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\v6\*.txt" Exclude="models\v6\ppocrv6_tiny_dict.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- .lib 是给原生链接器使用的静态库，运行时只需要 onnxruntime.dll。 -->
  <Target Name="ExcludeNativeStaticLibrariesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_ComputeResolvedFilesToPublishTypes;GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
