<Window x:Class="FlashTrans.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="闪译 FlashTrans"
        Width="560" Height="460" MinWidth="380" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 标题栏 -->
                <RowDefinition Height="Auto" />   <!-- 输入区 -->
                <RowDefinition Height="Auto" />   <!-- 源标签 -->
                <RowDefinition Height="*" />      <!-- 结果区 -->
                <RowDefinition Height="Auto" />   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderDrag">
                <Grid Margin="7,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LangHost" Grid.Column="0" Orientation="Horizontal" />

                    <StackPanel x:Name="ToolHost" Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- ============ 输入区 ============ -->
            <Grid Grid.Row="1" Margin="9,8,9,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="Input" Grid.Row="0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="46" MaxHeight="132" Padding="8,6,8,6"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         TextChanged="OnInputChanged"
                         PreviewKeyDown="OnInputKeyDown" />

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <StackPanel x:Name="InputTools" Orientation="Horizontal" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="CharCount" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="TranslateBtn" Style="{StaticResource PrimaryBtn}"
                                Content="翻译" Padding="16,4" FontSize="12.5"
                                Click="OnTranslateClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ 翻译源标签 ============ -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" Margin="9,9,9,0"
                          PreviewMouseWheel="OnTabsWheel">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- ============ 结果区 ============ -->
            <Border Grid.Row="3" Margin="9,8,9,0" Padding="1,0,0,0">
                <ContentControl x:Name="ResultHost" />
            </Border>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="4" Background="{DynamicResource BgAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Padding="10,4" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel x:Name="StatusTools" Grid.Column="1" Orientation="Horizontal" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
